#!/usr/bin/env bash
# Test shim for deploy/tests/backup-failure-modes.sh: passthrough to the real docker, except
# "docker cp <ctr>:<...>/uploads -" when $SHIM_MODE is set. Writes what it did to $SHIM_LOG so the
# test can prove each failure case was really exercised (not vacuously passed).
if [ "$1" = cp ] && [ "${3:-}" = - ] && [[ "$2" == *uploads ]] && [ -n "${SHIM_MODE:-}" ]; then
  t=$(mktemp); /usr/bin/docker cp "$2" - > "$t"
  case "$SHIM_MODE" in
    partial)   # the real archive cut exactly where the 2nd file member starts, then die like a broken stream
      off=$(python3 -c "import tarfile,sys;f=[m for m in tarfile.open(sys.argv[1]) if m.isfile()];print(f[1].offset if len(f)>=2 else -1)" "$t")
      if [ "$off" -lt 0 ]; then echo "shim: partial needs >= 2 files in uploads" >&2; rm -f "$t"; exit 2; fi
      head -c "$off" "$t" > "$t.cut"
      python3 -c "import tarfile,sys;n=sum(m.isfile() for m in tarfile.open(sys.argv[1]));print(f'partial bytes={sys.argv[2]} files_in_cut={n}')" "$t.cut" "$off" >> "${SHIM_LOG:-/dev/null}"
      cat "$t.cut"; rm -f "$t" "$t.cut"; exit 1 ;;
    sparse)    # a valid tar holding a GNU sparse member of 3 GB apparent size
      d=$(mktemp -d); mkdir "$d/uploads"; truncate -s 3G "$d/uploads/big.jpg"
      tar -C "$d" --sparse --format=gnu -cf - uploads > "$t"
      python3 -c "import tarfile,sys;print('sparse members=',sum(m.issparse() for m in tarfile.open(sys.argv[1])))" "$t" >> "${SHIM_LOG:-/dev/null}"
      cat "$t"; rm -rf "$d" "$t"; exit 0 ;;
    slow)      # the real archive, delivered after ${SHIM_SLOW:-5} s (stands in for a long rsync-sized backup)
      sleep "${SHIM_SLOW:-5}"; cat "$t"; rm -f "$t"; exit 0 ;;
    many)      # a valid tar of 3000 empty files (inode-exhaustion shape, scaled down)
      d=$(mktemp -d); mkdir "$d/uploads"; (cd "$d/uploads" && seq 1 3000 | xargs touch)
      tar -C "$d" -cf - uploads > "$t"
      echo "many members=$(tar -tf "$t" | wc -l)" >> "${SHIM_LOG:-/dev/null}"
      cat "$t"; rm -rf "$d" "$t"; exit 0 ;;
  esac
fi
exec /usr/bin/docker "$@"
