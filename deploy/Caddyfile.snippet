# creekwatch.realm.watch: Creek Watch (IEEE OneAquaHealth hackathon), container on ubox0 at 127.0.0.1:8442.
# Public via the existing cloudflared tunnel (ingress -> https://localhost:443, SNI creekwatch.realm.watch);
# LAN resolves to Cloudflare too (a LAN A record broke Chrome: CF's HTTPS/SVCB record carries ECH). Repo: jphein/creek-watch deploy/. 2026-10-03
creekwatch.realm.watch {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	request_body {
		max_size 12MB
	}
	encode zstd gzip
	# Keep Cloudflare's edge from caching (it caches .js/.css/.jpg 4 h by default):
	#  - photos: "private" = browser may cache, edge may not, so deleting/moderating a report takes effect;
	#  - everything else: revalidate, so a redeploy reaches phones immediately.
	# no-transform everywhere: stops Cloudflare injecting its Web Analytics beacon into our HTML (the About
	# page promises no trackers) and from rewriting images/scripts.
	@uploads path /uploads/*
	header @uploads Cache-Control "private, max-age=86400, no-transform"
	@notuploads not path /uploads/*
	header @notuploads Cache-Control "no-cache, no-transform"
	# Client IP for the app's per-IP rate limit. Only cloudflared on localhost is Cloudflare: for those
	# requests CF-Connecting-IP is the real phone. Anything else hitting Caddy directly (10.0.6.11 is
	# reachable from other VLANs) could forge that header, so strip it and let Caddy set XFF to the
	# true peer. (Presence-only matching was spoofable; Oracle gate-13-17.)
	@viacf {
		remote_ip 127.0.0.1 ::1
		header CF-Connecting-IP *
	}
	handle @viacf {
		reverse_proxy 127.0.0.1:8442 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8442 {
			header_up -CF-Connecting-IP
			header_up X-Forwarded-For {remote_host}
		}
	}
}
